rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Access model
    // Every academy gets ONE owner uid. Only that uid can read or write the
    // academy data. New sign-ups do not get access automatically: add their
    // uid here (or in a /owners/{uid} doc) before they can use the cloud.
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // 1) Owner allow-list stored in the database (recommended)
    function isListedOwner() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    // 2) Optional hard-coded owner uids (comma separated in the string below)
    function isEnvOwner() {
      return isSignedIn() &&
        request.auth.uid in [];   // e.g. ['uidOfTheAcademyManager']
    }

    function isOwner() {
      return isSignedIn() && (isListedOwner() || isEnvOwner());
    }

    // Profiles are private to their own user. Only managers may self-register.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/owners/$(userId))
        && !exists(/databases/$(database)/documents/users/$(userId));
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // The owner allow-list can only be managed from the Firebase console
    // (Admin SDK). Clients can read only their own entry.
    match /owners/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // One document per academy owner. Only the owner may touch it.
    match /academies/{ownerUid} {
      allow read: if isSignedIn() && request.auth.uid == ownerUid;
      allow write: if isSignedIn() && request.auth.uid == ownerUid;
    }

    // Business data: readable/writable only by the academy owner(s)
    match /students/{id}     { allow read, write: if isOwner(); }
    match /courses/{id}      { allow read, write: if isOwner(); }
    match /enrollments/{id}  { allow read, write: if isOwner(); }
    match /installments/{id} { allow read, write: if isOwner(); }
    match /payments/{id}     { allow read, write: if isOwner(); }
    match /expenses/{id}     { allow read, write: if isOwner(); }
    match /refunds/{id}      { allow read, write: if isOwner(); }
    match /bankAccounts/{id} { allow read, write: if isOwner(); }
    match /messageLogs/{id}  { allow read, write: if isOwner(); }
    match /notifications/{id}{ allow read, write: if isOwner(); }
    match /settings/{id}     { allow read, write: if isOwner(); }
    match /reminders/{id}    { allow read, write: if isOwner(); }

    // Audit log is append-only for the owner
    match /auditLogs/{id} {
      allow read: if isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }

    // Everything else is denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
