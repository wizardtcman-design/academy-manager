<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never upload the academy database or the auth preferences to Google Drive.
             They contain student personal data, bot tokens and PIN hashes. -->
        <exclude domain="database" path="academy_manager_database" />
        <exclude domain="database" path="academy_manager_database-wal" />
        <exclude domain="database" path="academy_manager_database-shm" />
        <exclude domain="sharedpref" path="academy_auth_prefs.xml" />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="academy_auth_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
