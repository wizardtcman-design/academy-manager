# ============================================================
# Cloudflare Worker Environment & Secret Template
# ============================================================

# Secret: Telegram Bot Token from @BotFather (DO NOT EXPOSE TO ANDROID)
# Set using: npx wrangler secret put TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Secret: Secure API Secret Key used by Android App for HTTPS API Authentication
# Set using: npx wrangler secret put API_SECRET_KEY
API_SECRET_KEY="your-secure-random-secret-key-min-32-chars"

# Optional Secret: Telegram Webhook verification secret
# Set using: npx wrangler secret put WEBHOOK_SECRET
WEBHOOK_SECRET="your-telegram-webhook-secret-token"

# Environment variables (Non-sensitive, can be kept in wrangler.toml [vars])
ENVIRONMENT="production"
BOT_USERNAME="YourAcademyBot"
