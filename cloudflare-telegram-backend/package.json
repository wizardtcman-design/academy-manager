{
  "name": "academy-manager1",
  "version": "1.0.0",
  "description": "Cloudflare Worker Backend for Telegram Bot Automation and Student Reminders",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "types": "wrangler types",
    "d1:init": "wrangler d1 execute academy-telegram-db --file=schema.sql --remote",
    "d1:init:local": "wrangler d1 execute academy-telegram-db --file=schema.sql --local",
    "secret:token": "wrangler secret put TELEGRAM_BOT_TOKEN",
    "secret:apikey": "wrangler secret put API_SECRET_KEY",
    "secret:webhook": "wrangler secret put WEBHOOK_SECRET",
    "test": "vitest run"
  },
  "keywords": [
    "cloudflare-workers",
    "telegram-bot",
    "d1",
    "cron-triggers",
    "student-reminders"
  ],
  "author": "Academy Management System",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^11.10.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9",
    "wrangler": "^3.75.0"
  }
}
